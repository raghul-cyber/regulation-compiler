# RegCompiler - API Environment Variables

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/regulation_db"

# Redis (Celery & Caching)
REDIS_URL="redis://localhost:6379/0"

# Clerk Authentication
CLERK_SECRET_KEY="sk_test_placeholder"

# LLM Providers (OpenAI / Gemini)
OPENAI_API_KEY="sk-proj-placeholder"
GEMINI_API_KEY="placeholder_gemini_key"

# Dodo Payments Integration (Production Usage Limits & Monetization)
DODO_PAYMENTS_API_KEY="test_placeholder_api_key"
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_placeholder_webhook_secret"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/billing/success"
DODO_PAYMENTS_PRODUCT_ID="prod_placeholder_product_id"

# General
ENVIRONMENT="development"
DEBUG=true
